#!/usr/bin/env bash
set -euo pipefail

if ((EUID != 0)); then
  exec sudo -- "$0" "$@"
fi

readonly EDID_PATH="/usr/lib/firmware/edid/sunshine-4k60-hdr.bin"
readonly DRACUT_CONFIG="/etc/dracut.conf.d/50-sunshine-edid.conf"
readonly GRUB_DEFAULTS="/etc/default/grub"

cp --archive "$GRUB_DEFAULTS" "${GRUB_DEFAULTS}.before-sunshine-edid-remove"
perl -0pi -e \
  's/[ \t]+drm\.edid_firmware=HDMI-A-1:edid\/sunshine-4k60-hdr\.bin//g; s/[ \t]+video=HDMI-A-1:e//g' \
  "$GRUB_DEFAULTS"
rm -f "$DRACUT_CONFIG" "$EDID_PATH"

update-grub
update-initramfs -u -k all

printf '\nRemoved the forced HDMI-A-1 EDID override. Reboot is required.\n'
printf 'After reboot, the HDMI port will use a physically connected display EDID again.\n'
