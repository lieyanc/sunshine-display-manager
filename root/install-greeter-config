#!/usr/bin/env bash
set -euo pipefail

if ((EUID != 0)); then
  exec sudo -- "$0" "$@"
fi

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SOURCE="${SCRIPT_DIR}/../config/gdm-monitors.xml"
readonly DISPLAYCTL="${SCRIPT_DIR}/../bin/sunshine-displayctl"

read_constant() {
  sed -n "s/^readonly $1=\"\(.*\)\"\$/\1/p" "$DISPLAYCTL"
}

physical_connector=$(read_constant PHYSICAL_CONNECTOR)
physical_mode=$(read_constant PHYSICAL_MODE)
virtual_connector=$(read_constant VIRTUAL_CONNECTOR)
mode_width=${physical_mode%%x*}
mode_height=${physical_mode#*x}
mode_height=${mode_height%%@*}
mode_rate=${physical_mode#*@}

for fragment in \
  "<connector>${physical_connector}</connector>" \
  "<width>${mode_width}</width>" \
  "<height>${mode_height}</height>" \
  "<rate>${mode_rate}</rate>" \
  "<connector>${virtual_connector}</connector>"; do
  if ! grep -Fq "$fragment" "$SOURCE"; then
    printf '%s does not match %s: %s is missing.\n' \
      "$SOURCE" "$DISPLAYCTL" "$fragment" >&2
    exit 1
  fi
done

python3 - "$SOURCE" "$virtual_connector" <<'PY'
import sys
import xml.etree.ElementTree as ElementTree

path, virtual = sys.argv[1], sys.argv[2]
root = ElementTree.parse(path).getroot()
enabled = {
    spec.findtext("connector")
    for spec in root.iterfind("./configuration/logicalmonitor/monitor/monitorspec")
}
if not enabled:
    raise SystemExit(f"{path} does not enable any monitor.")
if virtual in enabled:
    raise SystemExit(f"{path} enables {virtual}; the greeter must never use it.")
PY

gdm_home=$(getent passwd gdm | cut -d: -f6)
if [[ -z "$gdm_home" ]]; then
  printf 'The gdm user does not exist. Is GDM the active display manager?\n' >&2
  exit 1
fi
readonly CONFIG_DIR="${gdm_home}/.config"
readonly TARGET="${CONFIG_DIR}/monitors.xml"

if [[ ! -d "$CONFIG_DIR" ]]; then
  install -d --mode=0755 "$CONFIG_DIR"
fi
if [[ -e "$TARGET" ]] && ! cmp --silent "$TARGET" "$SOURCE"; then
  cp --archive --update=none "$TARGET" "${TARGET}.before-sunshine-display"
fi
install --mode=0644 "$SOURCE" "$TARGET"

printf '\nInstalled %s.\n' "$TARGET"
printf 'The greeter now uses %s only and keeps %s disabled.\n' \
  "$physical_connector" "$virtual_connector"
printf 'It is owned by root, so the greeter cannot overwrite it.\n'
printf 'Take effect by switching users, logging out or rebooting.\n'
