#!/usr/bin/env bash
# Installed as /usr/local/sbin/sunshine-boot-mode and exposed to the desktop
# user through /etc/sudoers.d/sunshine-display-manager. Picking a boot entry and
# forcing a DRM connector are the only things this project needs root for at
# runtime, so this accepts a fixed set of verbs and never takes a free-form
# argument.
set -euo pipefail

readonly GRUB_CFG="/boot/grub/grub.cfg"
readonly GRUB_ENV="/boot/grub/grubenv"
readonly VIRTUAL_ID_PREFIX="sunshine-gnulinux-simple-"
readonly STOCK_ID_PREFIX="gnulinux-simple-"
# /boot/grub is root-only and polling it through sudo would flood the audit log,
# so the armed state is mirrored here. /run is cleared on boot, which is exactly
# when the one-shot entry is consumed.
readonly PENDING_MARKER="/run/sunshine-display-boot-pending"

if ((EUID != 0)); then
  printf 'sunshine-boot-mode must run as root.\n' >&2
  exit 1
fi

# The virtual display can sit on either port, so the connector to force is
# whichever one this boot injected the EDID on. Nothing else can be forced: an
# output without the override would come up with no modes.
booted_connector() {
  local cmdline
  cmdline=$(</proc/cmdline)
  [[ "$cmdline" =~ drm\.edid_firmware=([A-Za-z0-9-]+):edid/sunshine-4k60-hdr\.bin ]] ||
    return 1
  printf '%s\n' "${BASH_REMATCH[1]}"
}

menu_entry_ids() {
  grep -oE -- "(--id|[\$]menuentry_id_option) '[^']*'" "$GRUB_CFG" |
    sed -E "s/^[^']*'//; s/'\$//"
}

entry_id() {
  case "$1" in
    virtual) menu_entry_ids | grep -m1 "^${VIRTUAL_ID_PREFIX}" || true ;;
    stock) menu_entry_ids | grep -m1 "^${STOCK_ID_PREFIX}" || true ;;
  esac
}

grubenv_value() {
  [[ -r "$GRUB_ENV" ]] || return 0
  grub-editenv "$GRUB_ENV" list 2>/dev/null | sed -n "s/^$1=//p"
}

# Maps a menu identifier back to the name this tool uses for it.
entry_name() {
  local id=$1

  [[ -n "$id" ]] || { printf 'none\n'; return 0; }
  if [[ "$id" == "${VIRTUAL_ID_PREFIX}"* ]]; then
    printf 'virtual\n'
  elif [[ "$id" == "${STOCK_ID_PREFIX}"* ]]; then
    printf 'stock\n'
  else
    printf 'other\n'
  fi
}

status_path() {
  local path
  for path in /sys/class/drm/card*-"$1"/status; do
    if [[ -w "$path" ]]; then
      printf '%s\n' "$path"
      return 0
    fi
  done
  return 1
}

print_status() {
  local path connector state=unknown

  connector=$(booted_connector || printf 'none\n')
  if [[ "$connector" != none ]] && path=$(status_path "$connector"); then
    state=$(<"$path")
  fi
  printf 'booted=%s\n' "$([[ "$connector" == none ]] && printf stock || printf virtual)"
  printf 'default=%s\n' "$(entry_name "$(grubenv_value saved_entry)")"
  printf 'pending=%s\n' "$(entry_name "$(grubenv_value next_entry)")"
  printf 'connector_name=%s\n' "$connector"
  printf 'connector=%s\n' "$state"
  printf 'entry_installed=%s\n' \
    "$([[ -n "$(entry_id virtual)" ]] && printf yes || printf no)"
}

# Arming the entry that is already the saved default just clears any pending
# one-shot, so both directions work no matter which entry is the default.
arm_entry() {
  local target=$1 id

  id=$(entry_id "$target")
  if [[ -z "$id" ]]; then
    printf 'No %s boot entry in %s. Run root/install-boot-entry first.\n' \
      "$target" "$GRUB_CFG" >&2
    return 1
  fi
  if [[ "$id" == "$(grubenv_value saved_entry)" ]]; then
    grub-editenv "$GRUB_ENV" unset next_entry
    rm -f "$PENDING_MARKER"
    printf 'The %s entry is already the default; cleared any pending boot.\n' \
      "$target"
    return 0
  fi
  grub-reboot "$id"
  printf '%s\n' "$target" >"$PENDING_MARKER"
  chmod 0644 "$PENDING_MARKER"
  printf 'The next boot will use the %s entry (%s).\n' "$target" "$id"
}

cancel_pending() {
  grub-editenv "$GRUB_ENV" unset next_entry
  rm -f "$PENDING_MARKER"
  printf 'Cleared the pending boot entry.\n'
}

# The EDID override is consumed at the first probe of the connector and the
# kernel keeps it for the lifetime of that connector, so nothing can inject it
# later. Refuse rather than force an output that would come up without modes.
set_connector() {
  local action=$1 connector path

  if ! connector=$(booted_connector); then
    printf 'No EDID is injected in this boot.\n' >&2
    printf 'Reboot into the virtual display entry first.\n' >&2
    return 1
  fi
  if ! path=$(status_path "$connector"); then
    printf 'No writable status attribute for %s.\n' "$connector" >&2
    return 1
  fi
  printf '%s\n' "$action" >"$path"
}

case "${1:-status}" in
  status) print_status ;;
  arm-virtual) arm_entry virtual ;;
  arm-stock) arm_entry stock ;;
  arm-cancel) cancel_pending ;;
  attach) set_connector on ;;
  detach) set_connector detect ;;
  reboot) systemctl reboot ;;
  *)
    printf 'Usage: %s {status|arm-virtual|arm-stock|arm-cancel|attach|detach|reboot}\n' \
      "$0" >&2
    exit 2
    ;;
esac
