#!/usr/bin/env bash
set -euo pipefail

readonly PHYSICAL_CONNECTOR="DP-1"
# Kernel connector names, used to read the real KMS state out of sysfs. Mutter
# reports the configuration it accepted, which is not always the one the driver
# committed, so every topology change is confirmed against these.
readonly PHYSICAL_KERNEL_CONNECTOR="DP-1"
readonly PHYSICAL_MODE="1920x1080@165.001"
readonly VIRTUAL_MODE="3840x2160@59.997"
readonly VIRTUAL_SCALE="2"
readonly SUNSHINE_SERVICE="app-dev.lizardbyte.app.Sunshine.service"
readonly BOOT_HELPER="/usr/local/sbin/sunshine-boot-mode"
readonly PORT_HELPER="/usr/local/sbin/sunshine-display-port"
readonly PORT_CONFIG="/etc/default/sunshine-display-manager"
readonly DEFAULT_PORT_CONNECTOR="DP-3"
readonly BOOT_PENDING_MARKER="/run/sunshine-display-boot-pending"
readonly INHIBIT_SERVICE="sunshine-display-inhibit.service"

uid=$(id -u)
: "${XDG_RUNTIME_DIR:=/run/user/${uid}}"
: "${DBUS_SESSION_BUS_ADDRESS:=unix:path=${XDG_RUNTIME_DIR}/bus}"
export XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS

readonly CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/sunshine-display-manager"
readonly SETTINGS_FILE="${CONFIG_DIR}/settings"
readonly RUNTIME_DIR="${XDG_RUNTIME_DIR}/sunshine-display-manager"
readonly STATE_FILE="${RUNTIME_DIR}/state"
readonly LOCK_FILE="${RUNTIME_DIR}/control.lock"

mkdir -p "$CONFIG_DIR" "$RUNTIME_DIR"
exec 9>"$LOCK_FILE"
flock -x 9

# The virtual display can live on either of two ports. Everything about it is
# identical except the connector and the colour space: HDR needs DRM metadata the
# driver only emits over HDMI, so a forced DisplayPort connector stays SDR. See
# docs/dp-hdr-investigation.zh-CN.md for the evidence.
port_connector() {
  case "$1" in
    dp) printf 'DP-3\n' ;;
    hdmi) printf 'HDMI-A-1\n' ;;
    *) return 1 ;;
  esac
}

port_name() {
  case "$1" in
    DP-3) printf 'dp\n' ;;
    HDMI-A-1) printf 'hdmi\n' ;;
    *) printf 'unknown\n' ;;
  esac
}

# Mutter names the HDMI connector differently from the kernel.
port_monitor() {
  case "$1" in
    HDMI-A-1) printf 'HDMI-1\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

port_color_mode() {
  case "$1" in
    HDMI-A-1) printf 'bt2100\n' ;;
    *) printf 'default\n' ;;
  esac
}

# The EDID can only be injected at boot, so the port carrying the virtual display
# is whatever the running kernel was told to override. Empty means this boot has
# no virtual display at all.
booted_port_connector() {
  local cmdline
  cmdline=$(</proc/cmdline)
  [[ "$cmdline" =~ drm\.edid_firmware=([A-Za-z0-9-]+):edid/sunshine-4k60-hdr\.bin ]] ||
    return 1
  printf '%s\n' "${BASH_REMATCH[1]}"
}

# What the boot entry will inject next time. Root owns the file but everyone can
# read it, so the indicator can show a queued switch without asking for a password.
# The generated GRUB entry sources this file, so read it the same way: a parser of
# its own would eventually report a port other than the one that gets booted.
configured_port_connector() {
  local value=""

  if [[ -r "$PORT_CONFIG" ]]; then
    value=$(
      . "$PORT_CONFIG" >/dev/null 2>&1 || exit 1
      printf '%s\n' "${SUNSHINE_VIRTUAL_CONNECTOR-}"
    ) || value=""
  fi
  if [[ "$(port_name "$value")" == unknown ]]; then
    value=$DEFAULT_PORT_CONNECTOR
  fi
  printf '%s\n' "$value"
}

# Under the stock entry there is no injected connector, but the names still have
# to resolve so status output and error messages can talk about the selected port.
VIRTUAL_KERNEL_CONNECTOR=$(booted_port_connector || configured_port_connector)
readonly VIRTUAL_KERNEL_CONNECTOR
readonly VIRTUAL_CONNECTOR="$(port_monitor "$VIRTUAL_KERNEL_CONNECTOR")"
readonly VIRTUAL_COLOR_MODE="$(port_color_mode "$VIRTUAL_KERNEL_CONNECTOR")"

AUTO_HIDE_PHYSICAL=1
STREAM_ACTIVE=0

load_settings() {
  local key value

  [[ -r "$SETTINGS_FILE" ]] || return 0
  while IFS='=' read -r key value; do
    case "$key" in
      auto_hide_physical)
        case "$value" in
          1 | true | yes | enabled) AUTO_HIDE_PHYSICAL=1 ;;
          0 | false | no | disabled) AUTO_HIDE_PHYSICAL=0 ;;
        esac
        ;;
    esac
  done <"$SETTINGS_FILE"
}

save_settings() {
  local tmp
  tmp=$(mktemp "${CONFIG_DIR}/settings.XXXXXX")
  printf 'auto_hide_physical=%s\n' "$AUTO_HIDE_PHYSICAL" >"$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$SETTINGS_FILE"
}

load_runtime_state() {
  local key value

  STREAM_ACTIVE=0
  [[ -r "$STATE_FILE" ]] || return 0
  while IFS='=' read -r key value; do
    case "$key" in
      stream_active)
        if [[ "$value" == 1 ]]; then
          STREAM_ACTIVE=1
        fi
        ;;
    esac
  done <"$STATE_FILE"
}

save_runtime_state() {
  local tmp
  tmp=$(mktemp "${RUNTIME_DIR}/state.XXXXXX")
  printf 'stream_active=%s\n' "$STREAM_ACTIVE" >"$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$STATE_FILE"
}

require_gnome_session() {
  if [[ ! -S "${XDG_RUNTIME_DIR}/bus" ]]; then
    printf 'GNOME session bus is unavailable at %s. Is the desktop user logged in?\n' \
      "${XDG_RUNTIME_DIR}/bus" >&2
    return 1
  fi
}

# The EDID can only be injected at boot, so the virtual display is available
# exactly when the machine booted the entry that carries the kernel argument.
boot_mode() {
  if booted_port_connector >/dev/null; then
    printf 'virtual\n'
  else
    printf 'stock\n'
  fi
}

boot_helper() {
  [[ -x "$BOOT_HELPER" ]] || return 1
  sudo -n "$BOOT_HELPER" "$@"
}

# Reads the marker the helper leaves behind instead of asking for root, so the
# indicator can poll this every few seconds.
boot_pending() {
  local pending

  if [[ -r "$BOOT_PENDING_MARKER" ]]; then
    pending=$(<"$BOOT_PENDING_MARKER")
    case "$pending" in
      virtual | stock)
        printf '%s\n' "$pending"
        return 0
        ;;
    esac
  fi
  printf 'none\n'
}

virtual_present() {
  local state="${1:-}"

  if [[ -z "$state" ]]; then
    require_gnome_session
    state=$(gdctl show --properties)
  fi
  grep -Fq "Monitor ${VIRTUAL_CONNECTOR} (" <<<"$state"
}

# The virtual entry leaves the connector disconnected so the greeter cannot land
# on it. Forcing it on is what makes the virtual display appear, and Mutter needs
# a moment to process the resulting hotplug.
ensure_virtual_connector() {
  local attempt

  [[ "$(boot_mode)" == virtual ]] || return 1
  # Mutter's monitor list lags the kernel by a hotplug round trip, so a stale
  # entry must not be read as an attached connector. Drive the kernel state and
  # then wait for both views to agree.
  if [[ "$(connector_status "$VIRTUAL_KERNEL_CONNECTOR")" != connected ]]; then
    boot_helper attach >/dev/null || return 1
  fi
  for attempt in {1..20}; do
    if [[ "$(connector_status "$VIRTUAL_KERNEL_CONNECTOR")" == connected ]] &&
      virtual_present; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

# Deliberately free of any gdctl call: this also runs while the session is being
# torn down, when the GNOME session bus may already be gone.
release_virtual_connector() {
  [[ "$(boot_mode)" == virtual ]] || return 0
  boot_helper detach >/dev/null
}

require_virtual_present() {
  ensure_virtual_connector && return 0
  if [[ "$(boot_mode)" == virtual ]]; then
    printf 'The virtual connector did not come back. Check %s.\n' "$BOOT_HELPER" >&2
  else
    printf 'The virtual display is not available in this boot.\n' >&2
    printf 'Reboot into the virtual display entry first: %s boot-virtual\n' "$0" >&2
  fi
  return 1
}

current_topology() {
  local state="${1:-}" logical physical=false virtual=false

  if [[ -z "$state" ]]; then
    require_gnome_session
    state=$(gdctl show --properties)
  fi
  logical=${state#*Logical monitors:}
  if [[ "$logical" == "$state" ]]; then
    printf 'unknown\n'
    return 0
  fi
  if grep -Fq "${PHYSICAL_CONNECTOR} (" <<<"$logical"; then
    physical=true
  fi
  if grep -Fq "${VIRTUAL_CONNECTOR} (" <<<"$logical"; then
    virtual=true
  fi

  if $physical && $virtual; then
    printf 'both\n'
  elif $physical; then
    printf 'physical-only\n'
  elif $virtual; then
    printf 'virtual-only\n'
  else
    printf 'unknown\n'
  fi
}

connector_enabled() {
  local path
  for path in /sys/class/drm/card*-"$1"/enabled; do
    [[ -r "$path" ]] || continue
    [[ "$(<"$path")" == enabled ]]
    return
  done
  return 1
}

connector_status() {
  local path
  for path in /sys/class/drm/card*-"$1"/status; do
    [[ -r "$path" ]] || continue
    printf '%s\n' "$(<"$path")"
    return 0
  done
  return 1
}

wait_for_connector() {
  local connector=$1 want=$2 attempt

  for attempt in {1..16}; do
    if [[ "$want" == enabled ]]; then
      connector_enabled "$connector" && return 0
    else
      connector_enabled "$connector" || return 0
    fi
    sleep 0.25
  done
  return 1
}

# Mutter keeps its logical view even when the driver rejects the commit, which
# leaves the desktop and the hardware disagreeing about which output is live.
confirm_topology() {
  local physical virtual

  case "$1" in
    physical-only) physical=enabled virtual=disabled ;;
    virtual-only) physical=disabled virtual=enabled ;;
    both) physical=enabled virtual=enabled ;;
    *) return 1 ;;
  esac
  if wait_for_connector "$PHYSICAL_KERNEL_CONNECTOR" "$physical" &&
    wait_for_connector "$VIRTUAL_KERNEL_CONNECTOR" "$virtual"; then
    return 0
  fi
  printf 'The driver did not apply %s: %s is %s, %s is %s.\n' "$1" \
    "$PHYSICAL_KERNEL_CONNECTOR" \
    "$(connector_enabled "$PHYSICAL_KERNEL_CONNECTOR" && printf enabled || printf disabled)" \
    "$VIRTUAL_KERNEL_CONNECTOR" \
    "$(connector_enabled "$VIRTUAL_KERNEL_CONNECTOR" && printf enabled || printf disabled)" >&2
  return 1
}

verify_flag() {
  if [[ "${1:-}" == verify ]]; then
    printf '%s\n' '--verify'
  fi
}

apply_physical_only() {
  local verify
  verify=$(verify_flag "${1:-}")
  gdctl set ${verify:+"$verify"} --layout-mode logical \
    --logical-monitor --primary --scale 1 --x 0 --y 0 \
    --monitor "$PHYSICAL_CONNECTOR" --mode "$PHYSICAL_MODE" \
    --color-mode default --rgb-range auto || return 1
  [[ -n "$verify" ]] || confirm_topology physical-only
}

apply_virtual_only() {
  local verify
  verify=$(verify_flag "${1:-}")

  gdctl set ${verify:+"$verify"} --layout-mode logical \
    --logical-monitor --primary --scale "$VIRTUAL_SCALE" --x 0 --y 0 \
    --monitor "$VIRTUAL_CONNECTOR" --mode "$VIRTUAL_MODE" \
    --color-mode "$VIRTUAL_COLOR_MODE" --rgb-range auto || return 1
  [[ -n "$verify" ]] || confirm_topology virtual-only
}

apply_both() {
  local verify
  verify=$(verify_flag "${1:-}")
  gdctl set ${verify:+"$verify"} --layout-mode logical \
    --logical-monitor --scale "$VIRTUAL_SCALE" --x 0 --y 0 \
    --monitor "$VIRTUAL_CONNECTOR" --mode "$VIRTUAL_MODE" \
    --color-mode "$VIRTUAL_COLOR_MODE" --rgb-range auto \
    --logical-monitor --primary --scale 1 --x 0 --y 1080 \
    --monitor "$PHYSICAL_CONNECTOR" --mode "$PHYSICAL_MODE" \
    --color-mode default --rgb-range auto || return 1
  [[ -n "$verify" ]] || confirm_topology both
}

apply_topology() {
  case "$1" in
    physical-only) apply_physical_only ;;
    virtual-only)
      require_virtual_present
      apply_virtual_only
      ;;
    both)
      require_virtual_present
      apply_both
      ;;
    *)
      printf 'Cannot apply unknown display topology: %s\n' "$1" >&2
      return 1
      ;;
  esac
}

manual_apply() {
  apply_topology "$1"
  # Nothing should be left holding a connector the topology does not use.
  if [[ "$1" == physical-only ]]; then
    release_virtual_connector
  fi
}

start_inhibitor() {
  systemctl --user stop "$INHIBIT_SERVICE" >/dev/null 2>&1 || true
  systemd-run --user --quiet --collect --unit="${INHIBIT_SERVICE%.service}" \
    /usr/bin/gnome-session-inhibit \
    --app-id=sunshine-display-manager \
    --reason=Sunshine-stream-active \
    --inhibit=idle --inhibit=suspend --inhibit-only
}

stop_inhibitor() {
  systemctl --user stop "$INHIBIT_SERVICE" >/dev/null 2>&1 || true
}

stream_start() {
  local original
  load_settings
  load_runtime_state
  ((STREAM_ACTIVE == 0)) || return 0

  original=$(current_topology)
  if [[ "$original" == unknown ]]; then
    printf 'Cannot start display automation from an unknown topology.\n' >&2
    return 1
  fi

  STREAM_ACTIVE=1
  save_runtime_state
  start_inhibitor

  if ((AUTO_HIDE_PHYSICAL)); then
    if ! ensure_virtual_connector; then
      # Streaming the physical display still works, so this must not abort the
      # session that Sunshine is already setting up.
      printf 'The virtual display is not available in this boot; keeping %s.\n' \
        "$original" >&2
    elif ! apply_virtual_only; then
      stop_inhibitor
      apply_topology "$original" || true
      STREAM_ACTIVE=0
      save_runtime_state
      return 1
    fi
  fi
}

# The topology that was on screen before the stream is deliberately not restored.
# Restoring a dual layout would leave the virtual display in Mutter after the
# session ends, and the whole point of the forced connector is that it exists only
# while something is streaming to it.
stream_stop() {
  load_runtime_state
  stop_inhibitor
  ((STREAM_ACTIVE)) || return 0

  apply_physical_only || true
  # Handing the connector back while Mutter still scans out of it would black the
  # desktop, so only release it once the physical display is the live output.
  if [[ "$(current_topology)" == physical-only ]]; then
    release_virtual_connector
  fi
  STREAM_ACTIVE=0
  save_runtime_state
}

set_auto_hide() {
  load_settings
  AUTO_HIDE_PHYSICAL=$1
  save_settings
}

recover_physical() {
  stop_inhibitor
  apply_physical_only
  release_virtual_connector
  STREAM_ACTIVE=0
  save_runtime_state
}

boot_switch() {
  local mode=$1 verb

  case "$mode" in
    virtual) verb=arm-virtual ;;
    stock) verb=arm-stock ;;
    *) return 2 ;;
  esac
  if ! boot_helper "$verb"; then
    printf 'Cannot run %s. Run root/install-boot-entry to set it up.\n' \
      "$BOOT_HELPER" >&2
    return 1
  fi
  boot_helper reboot
}

boot_cancel() {
  if ! boot_helper arm-cancel; then
    printf 'Cannot run %s. Run root/install-boot-entry to set it up.\n' \
      "$BOOT_HELPER" >&2
    return 1
  fi
}

# Moving the virtual display to the other port rewrites the kernel arguments of a
# GRUB entry, which is deliberately kept out of the passwordless sudoers rule: it
# is a rare, deliberate action, so it authenticates every time.
run_as_root() {
  local has_pkexec=0

  if command -v pkexec >/dev/null 2>&1; then
    has_pkexec=1
  fi
  # Prefer the polkit dialog whenever a graphical session can show one, even when
  # this was started from a terminal. The indicator runs the controller on a
  # background thread with its output captured, where a sudo tty prompt would
  # block out of sight and leave the menu stuck on "applying".
  if ((has_pkexec)) && [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
    pkexec "$@"
  elif [[ -t 0 ]]; then
    sudo -- "$@"
  elif ((has_pkexec)); then
    pkexec "$@"
  else
    printf 'No terminal to ask for a password on and pkexec is unavailable.\n' >&2
    return 1
  fi
}

port_switch() {
  local target=$1 connector

  connector=$(port_connector "$target") || return 2
  if [[ ! -x "$PORT_HELPER" ]]; then
    printf 'Cannot run %s. Run root/install-boot-entry to set it up.\n' \
      "$PORT_HELPER" >&2
    return 1
  fi
  if [[ "$(configured_port_connector)" == "$connector" &&
    "$(booted_port_connector || true)" == "$connector" ]]; then
    printf 'The virtual display already uses %s.\n' "$connector"
    return 0
  fi
  run_as_root "$PORT_HELPER" "$target" || return 1
  # The running kernel keeps the port it was booted with, so the switch is only
  # real after a reboot into the virtual entry the helper just made the default.
  # The helper has already committed it, so a reboot this tool cannot trigger is
  # an inconvenience, not a failed switch: say so rather than report an error.
  if ! boot_helper reboot; then
    printf 'The virtual display will use %s after the next reboot, but %s could\n' \
      "$connector" "$BOOT_HELPER"
    printf 'not trigger one. Reboot by hand.\n'
  fi
}

port_status() {
  local booted

  booted=$(booted_port_connector || printf 'none\n')
  printf 'port=%s\n' "$(port_name "$VIRTUAL_KERNEL_CONNECTOR")"
  printf 'port_connector=%s\n' "$booted"
  printf 'port_monitor=%s\n' "$VIRTUAL_CONNECTOR"
  printf 'port_color_mode=%s\n' "$VIRTUAL_COLOR_MODE"
  printf 'port_configured=%s\n' "$(port_name "$(configured_port_connector)")"
}

sunshine_control() {
  systemctl --user "$1" "$SUNSHINE_SERVICE"
}

# Extracts one monitor's block out of gdctl's tree so a property is read from the
# monitor it belongs to rather than from anywhere in the output.
monitor_block() {
  awk -v want="Monitor $1 (" '
    index($0, want) { block = 1; next }
    block && (index($0, "Monitor ") || $0 == "Logical monitors:") { exit }
    block { print }
  ' <<<"$2"
}

print_status_json() {
  local topology physical=false virtual=false sunshine=false hdr=false auto=false stream=false
  local display_state attached=false injected=false port configured

  load_settings
  load_runtime_state
  require_gnome_session
  display_state=$(gdctl show --properties)
  topology=$(current_topology "$display_state")
  case "$topology" in
    physical-only) physical=true ;;
    virtual-only) virtual=true ;;
    both) physical=true; virtual=true ;;
  esac
  if virtual_present "$display_state"; then
    attached=true
  fi
  if [[ "$(boot_mode)" == virtual ]]; then
    injected=true
  fi
  if systemctl --user is-active --quiet "$SUNSHINE_SERVICE"; then
    sunshine=true
  fi
  # supported-color-modes also lists bt2100, so only the active property counts.
  if $virtual && monitor_block "$VIRTUAL_CONNECTOR" "$display_state" |
    grep -E 'color-mode[^[:alpha:]].*bt2100' >/dev/null; then
    hdr=true
  fi
  if ((AUTO_HIDE_PHYSICAL)); then
    auto=true
  fi
  if ((STREAM_ACTIVE)); then
    stream=true
  fi
  port=$(port_name "$VIRTUAL_KERNEL_CONNECTOR")
  configured=$(port_name "$(configured_port_connector)")

  printf '{"topology":"%s","physical":%s,"virtual":%s,' \
    "$topology" "$physical" "$virtual"
  printf '"virtual_hdr":%s,"sunshine":%s,"stream_active":%s,' \
    "$hdr" "$sunshine" "$stream"
  printf '"auto_hide_physical":%s,' "$auto"
  printf '"virtual_injected":%s,"virtual_attached":%s,' "$injected" "$attached"
  printf '"virtual_port":"%s","virtual_port_configured":"%s",' "$port" "$configured"
  printf '"virtual_connector":"%s","virtual_port_hdr":%s,' \
    "$VIRTUAL_CONNECTOR" \
    "$([[ "$VIRTUAL_COLOR_MODE" == bt2100 ]] && printf true || printf false)"
  printf '"boot_mode":"%s","boot_pending":"%s"}\n' \
    "$(boot_mode)" "$(boot_pending)"
}

verify_configurations() {
  require_gnome_session
  require_virtual_present
  apply_physical_only verify
  apply_virtual_only verify
  apply_both verify
  printf 'All display configurations passed Mutter verification.\n'
}

print_usage() {
  cat <<USAGE
Usage: ${0##*/} <command>

Status
  status              current topology, boot mode and settings as JSON
  boot-status         current boot mode and the armed next boot
  port-status         the port the virtual display uses now and after a reboot
  verify              ask Mutter to validate every topology

Displays
  physical-only       switch to the physical display alone
  virtual-only        switch to the virtual display alone
  both                switch to the dual display layout
  physical-on         keep the physical display on, adding it if needed
  physical-off        turn the physical display off, keeping the virtual one
  virtual-on          keep the virtual display on, adding it if needed
  virtual-off         turn the virtual display off, keeping the physical one
  recover             force the physical display back and clear session state

Boot mode
  boot-virtual        boot the virtual display entry next and reboot now
  boot-stock          boot the stock entry next and reboot now
  boot-cancel         clear the armed boot without rebooting
  attach              force the virtual connector on
  detach              hand the virtual connector back

Virtual display port
  port-dp             put the virtual display on DP-3, SDR, and reboot now
  port-hdmi           put the virtual display on HDMI-A-1, HDR, and reboot now

Sunshine
  sunshine-on         start the Sunshine user service
  sunshine-off        stop the Sunshine user service
  sunshine-restart    restart the Sunshine user service

Automation
  auto-on             hide the physical display while streaming
  auto-off            do not switch to virtual-only when a stream starts
  stream-start        Sunshine session hook, not meant to be run by hand
  stream-stop         the same; always lands back on physical-only
USAGE
}

load_settings

case "${1:-status}" in
  status) print_status_json ;;
  physical-only) manual_apply physical-only ;;
  virtual-only) manual_apply virtual-only ;;
  both) manual_apply both ;;
  virtual-on)
    case "$(current_topology)" in
      physical-only) manual_apply both ;;
      virtual-only | both) ;;
      *) manual_apply virtual-only ;;
    esac
    ;;
  virtual-off)
    [[ "$(current_topology)" == physical-only ]] || manual_apply physical-only
    ;;
  physical-on)
    case "$(current_topology)" in
      virtual-only) manual_apply both ;;
      physical-only | both) ;;
      *) manual_apply physical-only ;;
    esac
    ;;
  physical-off)
    [[ "$(current_topology)" == virtual-only ]] || manual_apply virtual-only
    ;;
  auto-on) set_auto_hide 1 ;;
  auto-off) set_auto_hide 0 ;;
  stream-start) stream_start ;;
  stream-stop) stream_stop ;;
  recover) recover_physical ;;
  verify) verify_configurations ;;
  boot-status)
    printf 'boot_mode=%s\n' "$(boot_mode)"
    printf 'boot_pending=%s\n' "$(boot_pending)"
    ;;
  boot-virtual) boot_switch virtual ;;
  boot-stock) boot_switch stock ;;
  boot-cancel) boot_cancel ;;
  port-status) port_status ;;
  port-dp) port_switch dp ;;
  port-hdmi) port_switch hdmi ;;
  attach)
    if [[ "$(boot_mode)" == virtual ]]; then
      ensure_virtual_connector
    fi
    ;;
  detach) release_virtual_connector ;;
  sunshine-on) sunshine_control start ;;
  sunshine-off) sunshine_control stop ;;
  sunshine-restart) sunshine_control restart ;;
  help | --help | -h) print_usage ;;
  *)
    printf 'Unknown command: %s\n\n' "$1" >&2
    print_usage >&2
    exit 2
    ;;
esac
